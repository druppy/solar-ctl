#!/bin/sh
# solar-ctl copy of oe-core meta/files/overlayfs-etc-preinit.sh.in, with ONE
# addition: p4 (/data) self-heal before the overlay mount (e2fsck, last
# resort reformat) so a corrupted /data can never brick the boot. This file
# is rendered with python str.format(): single-brace tokens below are
# substituted by overlayfs-etc.bbclass, and NO other curly braces may ever
# be added to this file (shell functions with braces need doubling).

echo "PREINIT: Start"

PATH=/sbin:/bin:/usr/sbin:/usr/bin
if {CREATE_MOUNT_DIRS}; then
    mount -o remount,rw /

    mkdir -p /proc
    mkdir -p /sys
    mkdir -p /run
    mkdir -p /var/run
    mkdir -p {OVERLAYFS_ETC_MOUNT_POINT}
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys

[ -z "$CONSOLE" ] && CONSOLE="/dev/console"

BASE_OVERLAY_ETC_DIR={OVERLAYFS_ETC_MOUNT_POINT}/overlay-etc
UPPER_DIR=$BASE_OVERLAY_ETC_DIR/upper
WORK_DIR=$BASE_OVERLAY_ETC_DIR/work
LOWER_DIR=$BASE_OVERLAY_ETC_DIR/lower

# /data self-heal. The ext4 journal normally replays on its own; this only
# fires on real corruption (torn superblock/block group from a power cut).
# Order: plain mount -> e2fsck -y -> reformat. Losing /data (app state +
# the shared /etc overlay upper) is bad; a board that cannot boot is worse.
DATA_MOUNTED=0
for attempt in 1 2 3; do
    if mount -n -t {OVERLAYFS_ETC_FSTYPE} \
        -o {OVERLAYFS_ETC_MOUNT_OPTIONS} \
        {OVERLAYFS_ETC_DEVICE} {OVERLAYFS_ETC_MOUNT_POINT}; then
        DATA_MOUNTED=1
        break
    fi
    if [ "$attempt" = "1" ]; then
        echo "PREINIT: /data mount failed, running e2fsck"
        e2fsck -y {OVERLAYFS_ETC_DEVICE}
    else
        echo "PREINIT: /data unfixable, reformatting - ALL DATA LOST"
        mkfs.ext4 -F -q -L data {OVERLAYFS_ETC_DEVICE}
    fi
done

if [ "$DATA_MOUNTED" = "1" ]; then
    mkdir -p $UPPER_DIR
    mkdir -p $WORK_DIR

    if {OVERLAYFS_ETC_EXPOSE_LOWER}; then
        mkdir -p $LOWER_DIR

        # provide read-only access to original /etc content
        mount -o bind,ro /etc $LOWER_DIR
    fi

    mount -n -t overlay \
        -o upperdir=$UPPER_DIR \
        -o lowerdir=/etc \
        -o workdir=$WORK_DIR \
        -o index=off,xino=off,redirect_dir=off,metacopy=off \
        $UPPER_DIR /etc || \
            echo "PREINIT: Mounting etc-overlay failed!"
else
    echo "PREINIT: Mounting </data> failed!"
fi

umount /sys
umount /proc

echo "PREINIT: done; starting </sbin/init>"
exec {SBIN_INIT_NAME}
