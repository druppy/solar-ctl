/*
 * nv3007-overlay.dts - solar-ctl
 *
 * 2.79" NV3007 TFT (TZT 142x428 8-pin SPI module). Driven by the
 * generic panel-mipi-dbi driver (NOT ili9341 - that one hardcodes
 * 240x320). The mode comes from the panel-timing node below; the
 * NV3007 controller init sequence comes from the firmware file
 * /lib/firmware/panel-mipi-dbi-spi.bin, baked into the image by
 * fw/recipes-kernel/firmware-nv3007. Without that file the panel
 * simply stays dark (driver retries the request periodically).
 *
 * solar-ctl wiring (defaults; overridable on the dtoverlay= line):
 *   MOSI  GPIO10  (P1-19)
 *   SCLK  GPIO11  (P1-23)
 *   CE0   GPIO8   (P1-24)   SPI0 enabled by this overlay
 *   DC    GPIO25  (P1-22)   dc_pin=<n>
 *   RST   GPIO24  (P1-18)   reset_pin=<n>
 *   BLK   GPIO18  (P1-12)   led_pin=<n>   (gpio-backlight, default-on)
 *   VCC   3V3, GND
 *
 * Panel is native portrait 142x428; framebuffer /dev/fb0 (DRM fbdev
 * emulation). mipi-dbi has no DT rotation property - see README
 * "Display orientation" for the two supported ways to rotate.
 *
 * Enable in config.txt:  dtoverlay=nv3007
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&spidev0>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			nv3007_pins: nv3007_pins {
				brcm,pins = <25 24>;
				brcm,function = <1>; /* out */
			};
			nv3007_bl_pins: nv3007_bl_pins {
				brcm,pins = <18>;
				brcm,function = <1>; /* out */
			};
		};
	};

	fragment@2 {
		target-path = "/";
		__overlay__ {
			nv3007_backlight: backlight {
				compatible = "gpio-backlight";
				gpios = <&gpio 18 GPIO_ACTIVE_HIGH>;
				default-on;
				pinctrl-names = "default";
				pinctrl-0 = <&nv3007_bl_pins>;
			};
		};
	};

	fragment@3 {
		target = <&spi0>;
		__overlay__ {
			/* needed to avoid dtc warning */
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			nv3007: nv3007@0 {
				compatible = "panel-mipi-dbi-spi";
				reg = <0>;
				spi-max-frequency = <32000000>;
				dc-gpios = <&gpio 25 GPIO_ACTIVE_HIGH>;
				reset-gpios = <&gpio 24 GPIO_ACTIVE_HIGH>;
				pinctrl-names = "default";
				pinctrl-0 = <&nv3007_pins>;
				backlight = <&nv3007_backlight>;
				/* 16-bit pixel bus, init sequence via firmware
				   file (no native 18-bit mode on this module) */
				format = "r5g6b5";
				status = "okay";

				panel-timing {
					hactive = <142>;
					vactive = <428>;
					clock-frequency = <11800000>;
					hsync-len = <2>;
					vsync-len = <2>;
					/* porch values from the NV3007
					   reference driver; every other
					   timing property is blank (0) */
					hback-porch = <8>;
					hfront-porch = <8>;
					vback-porch = <10>;
					vfront-porch = <8>;
				};
			};
		};
	};

	__overrides__ {
		speed = <&nv3007>, "spi-max-frequency:0";
		dc_pin = <&nv3007>, "dc-gpios:4",
			 <&nv3007_pins>, "brcm,pins:4";
		reset_pin = <&nv3007>, "reset-gpios:4",
			    <&nv3007_pins>, "brcm,pins:0";
		led_pin = <&nv3007_backlight>, "gpios:4",
			  <&nv3007_bl_pins>, "brcm,pins:0";
	};
};
