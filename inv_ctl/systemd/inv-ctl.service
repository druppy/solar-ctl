[Unit]
Description=solar-ctl inverter controller UI
Documentation=https://github.com/druppy/solar-ctl
# /dev/fb0 appears only after the SPI panel probe (and its init firmware);
# inv-ctl itself retries until the device shows up.
After=local-fs.target

[Service]
# TZ for the watch face is baked from the SOLAR_TZ build variable into
# this file (inv-ctl recipe); absent = UTC. musl only understands POSIX
# TZ strings, not zoneinfo names - see fw/kas-rpi0.yml env:.
EnvironmentFile=-/etc/default/inv-ctl
ExecStart=/usr/bin/inv-ctl --backend fb --fb /dev/fb0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
